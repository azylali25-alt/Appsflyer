generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { owner analyst viewer }
enum UploadStatus { queued parsing done failed }
enum ActionStatus { draft queued done failed }
enum ActionKind { TEST PUSH OPTIMIZE EXTEND }
model User { id String @id @default(cuid()) email String @unique passwordHash String role Role @default(owner) locale String @default("en") createdAt DateTime @default(now()) uploads Upload[] actions Action[] auditLogs AuditLog[] }
model Upload { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) fileName String status UploadStatus @default(queued) mode String @default("append") rowsImported Int @default(0) rowsSkipped Int @default(0) duplicates Int @default(0) warnings Json? createdAt DateTime @default(now()) facts Fact[] @@index([userId,createdAt]) }
model Fact { id BigInt @id @default(autoincrement()) uploadId String upload Upload @relation(fields:[uploadId],references:[id],onDelete:Cascade) date DateTime app String? platform String? mediaSource String? channel String? campaign String? country String? eventName String? impressions Int? clicks Int? installs Int? cost Decimal? @db.Decimal(18,4) revenue Decimal? @db.Decimal(18,4) events Int? payers Int? uniqueUsers Int? raw Json? @@index([date]) @@index([mediaSource]) @@index([channel]) @@index([country]) }
model PayableEvent { id String @id @default(cuid()) userId String app String eventName String isPayable Boolean @default(true) @@unique([userId,app,eventName]) }
model Action { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) kind ActionKind targetType String targetKey String parameters Json evidence Json? status ActionStatus @default(draft) assignee String? notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId,createdAt]) }
model SavedMapping { id String @id @default(cuid()) userId String app String name String mapping Json createdAt DateTime @default(now()) @@unique([userId,app,name]) }
model AuditLog { id BigInt @id @default(autoincrement()) userId String? user User? @relation(fields:[userId],references:[id],onDelete:SetNull) event String metadata Json? ipHash String? createdAt DateTime @default(now()) @@index([createdAt]) }
